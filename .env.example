# ==============================================================================
# UniVerse AI — Environment Configuration Template
# Copy this file to .env.local and populate with your genuine service credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Authentication (Public Web App Config)
# Obtain from: Firebase Console -> Project Settings -> General -> Your apps (Web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 2. Firebase Admin SDK Secret Keys (Server-side Token Verification)
# Obtain by clicking: Firebase Console -> Project Settings -> Service accounts -> "Generate new private key"
#
# Choose EITHER Option A (Recommended: Individual fields) OR Option B (Single JSON):
#
# --- OPTION A (Recommended: Individual fields from downloaded JSON) ---
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PROJECT_ID=

# --- OPTION B (Alternative: Full JSON as single line string or Base64) ---
# FIREBASE_SERVICE_ACCOUNT_KEY=

# ------------------------------------------------------------------------------
# 3. Supabase PostgreSQL Database & Storage
# Obtain from: Supabase Dashboard (https://supabase.com/dashboard)
# -> Select Project -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 4. Google Gemini API (Phase 2 AI Chatbot & Natural Language Search)
# Obtain from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
